{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "native: dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "native: typecheck",
      "type": "shell",
      "command": "pnpm",
      "args": ["typecheck"],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "native: test",
      "type": "shell",
      "command": "pnpm",
      "args": ["test"],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "cargo: check",
      "type": "shell",
      "command": "cargo",
      "args": ["check", "--workspace", "--locked"],
      "problemMatcher": "$rustc",
      "group": "test"
    }
  ]
}
