import { Theme } from "tokens.slint";
import { IconButton } from "components.slint";
import { UiAttachment } from "models.slint";

export component ImagePreview inherits Rectangle {
    in-out property <bool> open: false;
    in property <[UiAttachment]> images;
    in-out property <int> index: 0;
    in property <string> previous-label;
    in property <string> next-label;
    in property <string> zoom-in-label;
    in property <string> zoom-out-label;
    in property <string> reset-label;
    in property <string> close-label;

    property <float> zoom: 1.0;
    property <length> offset-x: 0px;
    property <length> offset-y: 0px;
    property <length> drag-offset-x: 0px;
    property <length> drag-offset-y: 0px;
    property <float> preview-progress: root.open ? 1.0 : 0.0;

    animate preview-progress { duration: 160ms; easing: ease-out; }

    function reset-view() {
        root.zoom = 1.0;
        root.offset-x = 0px;
        root.offset-y = 0px;
    }

    function move-image(delta: int) {
        if root.images.length <= 0 { return; }
        root.index = mod(root.index + delta + root.images.length, root.images.length);
        root.reset-view();
    }

    function change-zoom(delta: float) {
        root.zoom = max(0.5, min(6.0, root.zoom + delta));
        if root.zoom <= 1.0 {
            root.offset-x = 0px;
            root.offset-y = 0px;
        }
    }

    visible: root.preview-progress > 0.0;
    opacity: root.preview-progress;
    background: #18212fc2;
    clip: true;

    changed open => {
        if root.open {
            root.reset-view();
            preview-focus.focus();
        }
    }

    TouchArea { enabled: root.open; clicked => { root.open = false; } }

    stage := Rectangle {
        x: 44px;
        y: 54px + (1.0 - root.preview-progress) * 8px;
        width: parent.width - 88px;
        height: parent.height - 96px;
        background: transparent;
        clip: true;

        if root.images.length > 0: Image {
            x: (parent.width - self.width) / 2 + root.offset-x;
            y: (parent.height - self.height) / 2 + root.offset-y;
            width: parent.width * root.zoom;
            height: parent.height * root.zoom;
            source: root.images[root.index].image;
            image-fit: contain;
        }

        drag-area := TouchArea {
            mouse-cursor: root.zoom > 1.0 ? grab : default;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-offset-x = root.offset-x;
                    root.drag-offset-y = root.offset-y;
                    preview-focus.focus();
                }
            }
            moved => {
                if root.zoom > 1.0 {
                    root.offset-x = root.drag-offset-x + self.mouse-x - self.pressed-x;
                    root.offset-y = root.drag-offset-y + self.mouse-y - self.pressed-y;
                }
            }
            double-clicked => { root.reset-view(); }
            scroll-event(event) => {
                root.change-zoom(event.delta-y < 0px ? 0.25 : -0.25);
                return accept;
            }
        }
    }

    if root.images.length > 1: IconButton {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 34px;
        height: 46px;
        icon: "‹";
        tooltip: root.previous-label;
        foreground: white;
        hover-foreground: white;
        hover-background: #ffffff33;
        clicked => { root.move-image(-1); }
    }

    if root.images.length > 1: IconButton {
        x: parent.width - 46px;
        y: (parent.height - self.height) / 2;
        width: 34px;
        height: 46px;
        icon: "›";
        tooltip: root.next-label;
        foreground: white;
        hover-foreground: white;
        hover-background: #ffffff33;
        clicked => { root.move-image(1); }
    }

    Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: controls.preferred-width + 8px;
        height: 36px;
        border-radius: 18px;
        border-width: 1px;
        border-color: #ffffff5c;
        background: #ffffff38;

        controls := HorizontalLayout {
            padding: 4px;
            spacing: 2px;
            alignment: center;
            Text {
                min-width: 42px;
                text: (root.index + 1) + " / " + root.images.length;
                color: #ffffffe0;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                min-width: 42px;
                text: round(root.zoom * 100) + "%";
                color: #ffffffe0;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            IconButton { icon: "−"; tooltip: root.zoom-out-label; foreground: white; hover-foreground: white; hover-background: #ffffff33; clicked => { root.change-zoom(-0.25); } }
            IconButton { icon: "+"; tooltip: root.zoom-in-label; foreground: white; hover-foreground: white; hover-background: #ffffff33; clicked => { root.change-zoom(0.25); } }
            IconButton { icon: "↶"; tooltip: root.reset-label; foreground: white; hover-foreground: white; hover-background: #ffffff33; clicked => { root.reset-view(); } }
            IconButton { icon: "×"; tooltip: root.close-label; foreground: white; hover-foreground: white; hover-background: #ffffff33; clicked => { root.open = false; } }
        }
    }

    preview-focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.open = false;
            } else if event.text == Key.PageUp || event.text == "[" {
                root.move-image(-1);
            } else if event.text == Key.PageDown || event.text == "]" {
                root.move-image(1);
            } else if event.text == Key.LeftArrow {
                if root.zoom > 1.0 { root.offset-x += 36px; } else { root.move-image(-1); }
            } else if event.text == Key.RightArrow {
                if root.zoom > 1.0 { root.offset-x -= 36px; } else { root.move-image(1); }
            } else if event.text == Key.UpArrow {
                if root.zoom > 1.0 { root.offset-y += 36px; }
            } else if event.text == Key.DownArrow {
                if root.zoom > 1.0 { root.offset-y -= 36px; }
            } else if event.text == "+" || event.text == "=" {
                root.change-zoom(0.25);
            } else if event.text == "-" || event.text == "_" {
                root.change-zoom(-0.25);
            } else if event.text == "0" {
                root.reset-view();
            } else {
                return reject;
            }
            return accept;
        }
    }
}
