{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NSH: dev",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "NSH: typecheck",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "typecheck"
      ],
      "problemMatcher": "$tsc",
      "group": "test"
    },
    {
      "label": "Rust: check",
      "type": "shell",
      "command": "cargo",
      "args": [
        "check",
        "--manifest-path",
        "native/Cargo.toml"
      ],
      "problemMatcher": "$rustc",
      "group": "test"
    }
  ]
}
