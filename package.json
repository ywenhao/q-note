{
  "name": "q-note",
  "version": "0.2.12",
  "description": "A lightweight native desktop note app built with Native Shell (nsh.dev).",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/ywenhao/q-note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywenhao/q-note.git"
  },
  "bugs": {
    "url": "https://github.com/ywenhao/q-note/issues"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/nsh.mjs run .",
    "dev:web": "node scripts/nsh.mjs run . --target web",
    "build": "node scripts/nsh.mjs build . --release",
    "package:windows": "node scripts/nsh.mjs package . --target windows -o dist/windows",
    "package:macos": "node scripts/nsh.mjs package . --target macos -o dist/macos",
    "package:linux": "node scripts/nsh.mjs package . --target linux -o dist/linux",
    "package:web": "node scripts/nsh.mjs package . --target web -o dist/web",
    "release": "node scripts/release.mjs",
    "release:major": "pnpm run release --release major",
    "release:minor": "pnpm run release --release minor",
    "release:patch": "pnpm run release --release patch",
    "format": "prettier --write App.tsx App.test.tsx Desktop.test.tsx src scripts nsh.json package.json tsconfig.json",
    "format:check": "prettier --check App.tsx App.test.tsx Desktop.test.tsx src scripts nsh.json package.json tsconfig.json",
    "typecheck": "node scripts/nsh.mjs check .",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.ts",
    "test:ui": "node scripts/nsh.mjs test App.test.tsx",
    "test:desktop": "node scripts/nsh.mjs test Desktop.test.tsx --target windows",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "check": "pnpm typecheck && pnpm format:check",
    "test:context-menu": "node --experimental-strip-types --test tests/contextMenuPosition.test.ts",
    "test:update-draft": "node --experimental-strip-types --test tests/updateDraft.test.ts tests/updateRecovery.test.ts",
    "test:updater": "node --experimental-strip-types --test tests/updateProgress.test.ts tests/updateInstallHint.test.ts",
    "test:window-state": "node --experimental-strip-types --test tests/windowState.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  }
}
