import { Theme } from "tokens.slint";
import { QMark, IconButton, PillButton, WindowControls } from "components.slint";
import { UiAttachment, UiColor, UiNote, UiStrings } from "models.slint";
import { NoteCard } from "note-card.slint";
import { ImagePreview } from "image-preview.slint";

export component MainWindow inherits Window {
    title: root.strings.app-title;
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 300px;
    preferred-height: 450px;
    min-width: 300px;
    min-height: 450px;
    max-width: 1000px;
    max-height: 800px;
    background: transparent;
    default-font-size: Theme.font-body;

    in property <[UiNote]> notes;
    in property <[UiColor]> palette;
    in property <UiStrings> strings;
    in property <bool> topmost: false;
    in property <string> total-label;
    in-out property <string> palette-note-id;
    in-out property <string> palette-selected-color;
    in-out property <bool> has-update: false;
    in-out property <int> modal-kind: 0;
    in-out property <bool> toast-visible: false;
    in-out property <string> toast-text;
    in-out property <bool> preview-open: false;
    in property <[UiAttachment]> preview-images;
    in-out property <int> preview-index: 0;
    in-out property <bool> auto-start: false;
    in-out property <bool> checking-update: false;
    in property <string> version-label;
    in-out property <string> update-version;
    in-out property <string> update-notes;
    in-out property <string> update-status;
    in-out property <float> update-progress: 0.0;
    in-out property <string> update-progress-label;
    in-out property <string> update-size-label;
    in-out property <bool> update-can-cancel: true;

    callback start-window-drag;
    callback toggle-topmost;
    callback minimize;
    callback hide-window;
    callback new-note;
    callback request-delete-all;
    callback open-settings;
    callback toggle-language;
    callback collapse-to-dock;
    callback copy-note(string);
    callback edit-note(string);
    callback toggle-pin(string);
    callback change-color(string, string);
    callback delete-note(string);
    callback preview-image(string, string);
    callback resize-note(string, int);
    callback make-note-drag-data(string) -> data-transfer;
    callback reorder-note(data-transfer, string, bool);
    callback confirm-delete-all;
    callback toggle-auto-start;
    callback import-data;
    callback export-data;
    callback check-update;
    callback open-version;
    callback confirm-update;
    callback cancel-update-download;

    property <bool> modal-shown: false;
    property <float> modal-progress: root.modal-shown ? 1.0 : 0.0;
    property <bool> palette-shown: false;
    property <float> palette-progress: root.palette-shown ? 1.0 : 0.0;
    property <float> toast-progress: root.toast-visible ? 1.0 : 0.0;

    animate modal-progress { duration: 160ms; easing: ease-out; }
    animate palette-progress { duration: 140ms; easing: ease-out; }
    animate toast-progress { duration: 140ms; easing: ease-out; }

    public function close-modal() {
        if root.modal-kind == 0 { return; }
        modal-open-timer.stop();
        root.modal-shown = false;
        modal-close-timer.start();
    }

    function close-palette() {
        if root.palette-note-id == "" { return; }
        palette-open-timer.stop();
        root.palette-shown = false;
        palette-close-timer.start();
    }

    changed modal-kind => {
        if root.modal-kind != 0 {
            modal-close-timer.stop();
            root.modal-shown = false;
            modal-open-timer.start();
        } else {
            modal-open-timer.stop();
            root.modal-shown = false;
        }
    }

    changed palette-note-id => {
        if root.palette-note-id != "" {
            palette-close-timer.stop();
            root.palette-shown = false;
            palette-open-timer.start();
        } else {
            palette-open-timer.stop();
            root.palette-shown = false;
        }
    }

    modal-open-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            if root.modal-kind != 0 { root.modal-shown = true; }
        }
    }

    modal-close-timer := Timer {
        interval: 160ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.modal-shown { root.modal-kind = 0; }
        }
    }

    palette-open-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            if root.palette-note-id != "" { root.palette-shown = true; }
        }
    }

    palette-close-timer := Timer {
        interval: 140ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.palette-shown { root.palette-note-id = ""; }
        }
    }

    always-on-top: root.topmost;

    Rectangle {
        background: Theme.app-background;
        border-radius: Theme.window-radius;
        clip: true;

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;

            Rectangle {
                height: 34px;
                background: transparent;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    title-drag := Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            QMark { mark-size: 22px; }
                            Text {
                                text: root.strings.app-title;
                                color: Theme.text;
                                font-size: Theme.font-title;
                                font-weight: 650;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            pointer-event(event) => {
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                    root.start-window-drag();
                                }
                            }
                        }
                    }

                    WindowControls {
                        always-on-top: root.topmost;
                        topmost-tooltip: root.topmost ? root.strings.always-off : root.strings.always-on;
                        minimize-tooltip: root.strings.minimize;
                        close-tooltip: root.strings.close-panel;
                        toggle-topmost => { root.toggle-topmost(); }
                        minimize => { root.minimize(); }
                        close => { root.hide-window(); }
                    }
                }
            }

            Rectangle {
                height: 36px;
                border-radius: Theme.control-radius;
                background: #ffffff24;

                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    alignment: start;

                    IconButton { use-image: true; icon-image: @image-url("../assets/plus.svg"); tooltip: root.strings.new-note; clicked => { root.new-note(); } }
                    IconButton {
                        use-image: true;
                        icon-image: @image-url("../assets/trash.svg");
                        tooltip: root.strings.delete-all;
                        foreground: Theme.danger;
                        hover-foreground: Theme.danger;
                        enabled: root.notes.length > 0;
                        clicked => { root.request-delete-all(); }
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        IconButton {
                            use-image: true;
                            icon-image: @image-url("../assets/settings.svg");
                            tooltip: root.has-update ? root.strings.update-available + ": " + root.update-version : root.strings.settings;
                            clicked => { root.open-settings(); }
                        }
                        if root.has-update: Rectangle {
                            x: 20px; y: 1px; width: 7px; height: 7px;
                            border-radius: 4px; background: Theme.danger;
                        }
                    }
                    PillButton {
                        icon: "文";
                        text: root.strings.language-toggle;
                        clicked => { root.toggle-language(); }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;

                if root.notes.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    QMark { mark-size: 52px; }
                    Text {
                        text: root.strings.empty-title;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 650;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.strings.no-notes-body;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        horizontal-alignment: center;
                    }
                    PillButton { text: root.strings.empty-action; primary: true; clicked => { root.new-note(); } }
                }

                if root.notes.length > 0: Flickable {
                    viewport-width: self.width;
                    viewport-height: max(self.height, note-list.preferred-height);

                    note-list := VerticalLayout {
                        width: parent.width;
                        spacing: 10px;
                        padding-bottom: 8px;

                        for note in root.notes: NoteCard {
                            width: parent.width;
                            note: note;
                            strings: root.strings;
                            palette-active: root.palette-note-id == note.id;
                            copy-note(id) => { root.copy-note(id); }
                            edit-note(id) => { root.edit-note(id); }
                            toggle-pin(id) => { root.toggle-pin(id); }
                            open-palette(id, selected) => {
                                root.palette-note-id = id;
                                root.palette-selected-color = selected;
                            }
                            delete-note(id) => { root.delete-note(id); }
                            preview-image(note-id, attachment-id) => { root.preview-image(note-id, attachment-id); }
                            resize-note(id, height) => { root.resize-note(id, height); }
                            make-drag-data(id) => { return root.make-note-drag-data(id); }
                            reorder-note(data, target-id, after) => { root.reorder-note(data, target-id, after); }
                        }
                    }
                }
            }

            Text {
                height: 18px;
                text: root.total-label;
                color: Theme.text-muted;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width - 44px;
            y: parent.height - 44px;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: #ffffff8c;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
            QMark { x: 5px; y: 5px; mark-size: 22px; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.collapse-to-dock(); }
            }
        }

        if root.palette-note-id != "": Rectangle {
            background: transparent;
            opacity: root.palette-progress;
            TouchArea { enabled: root.palette-shown; clicked => { root.close-palette(); } }

            Rectangle {
                x: parent.width - 126px;
                y: 90px + (1.0 - root.palette-progress) * 6px;
                width: 112px;
                height: 84px;
                border-radius: Theme.control-radius;
                border-width: 1px;
                border-color: #1d273524;
                background: #fffffff0;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 10px;
                drop-shadow-color: #1f232829;

                for swatch[index] in root.palette: Rectangle {
                    x: 8px + mod(index, 4) * 25px;
                    y: 7px + floor(index / 4) * 25px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: swatch.hex == root.palette-selected-color ? 2px : 1px;
                    border-color: swatch.hex == root.palette-selected-color ? #1d273573 : #1d273529;
                    background: swatch.value;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.change-color(root.palette-note-id, swatch.hex);
                            root.close-palette();
                        }
                    }
                }
            }
        }

        Rectangle {
            visible: root.toast-progress > 0.0;
            x: (parent.width - self.width) / 2;
            y: parent.height - 72px + (1.0 - root.toast-progress) * 6px;
            width: toast-label.preferred-width + 24px;
            height: 30px;
            opacity: root.toast-progress;
            border-radius: 15px;
            background: #1d1d1fe0;
            drop-shadow-blur: 14px;
            drop-shadow-color: #1f232833;
            toast-label := Text {
                text: root.toast-text;
                color: white;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.modal-kind == 1: Rectangle {
            background: #1d1d1f3d;
            opacity: root.modal-progress;
            TouchArea { enabled: root.modal-shown; clicked => { root.close-modal(); } }

            Rectangle {
                x: max(12px, (parent.width - self.width) / 2);
                y: (parent.height - self.height) / 2 + (1.0 - root.modal-progress) * 10px;
                width: min(420px, parent.width - 24px);
                height: confirm-layout.preferred-height;
                border-radius: Theme.window-radius;
                border-width: 1px;
                border-color: #ffffffa6;
                background: #fffdf4f2;
                drop-shadow-blur: 38px;
                drop-shadow-offset-y: 16px;
                drop-shadow-color: #1f232829;

                TouchArea { }
                confirm-layout := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: root.strings.confirm-delete-all;
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 650;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.strings.delete-all-body;
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        PillButton { text: root.strings.cancel; clicked => { root.close-modal(); } }
                        PillButton {
                            text: root.strings.delete;
                            danger: true;
                            clicked => {
                                root.confirm-delete-all();
                                root.close-modal();
                            }
                        }
                    }
                }
            }
        }

        if root.modal-kind == 2: Rectangle {
            background: #1d1d1f3d;
            opacity: root.modal-progress;
            TouchArea { enabled: root.modal-shown; clicked => { root.close-modal(); } }

            Rectangle {
                x: max(12px, (parent.width - self.width) / 2);
                y: (parent.height - self.height) / 2 + (1.0 - root.modal-progress) * 10px;
                width: min(300px, parent.width - 24px);
                height: settings-layout.preferred-height;
                border-radius: Theme.window-radius;
                border-width: 1px;
                border-color: #ffffffa6;
                background: #fffdf4f2;
                drop-shadow-blur: 38px;
                drop-shadow-offset-y: 16px;
                drop-shadow-color: #1f232829;

                TouchArea { }
                settings-layout := VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        Text {
                            text: root.strings.settings-title;
                            color: Theme.text;
                            font-size: Theme.font-title;
                            font-weight: 650;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        IconButton {
                            x: parent.width - self.width;
                            y: 0px;
                            icon: "×";
                            tooltip: root.strings.close-panel;
                            clicked => { root.close-modal(); }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: Theme.control-radius;
                        background: #ffffff94;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: center;
                            Image { width: 15px; height: 15px; source: @image-url("../assets/power.svg"); colorize: Theme.text-muted; image-fit: contain; }
                            Text {
                                horizontal-stretch: 1;
                                text: root.strings.startup-setting;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 38px; height: 22px; border-radius: 11px;
                                background: root.auto-start ? Theme.success : #3c3c432e;
                                Rectangle {
                                    x: root.auto-start ? 18px : 2px;
                                    y: 2px; width: 18px; height: 18px; border-radius: 9px;
                                    background: white;
                                    animate x { duration: 120ms; easing: ease-in-out; }
                                }
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.toggle-auto-start(); } }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        PillButton { horizontal-stretch: 1; text: root.strings.import; use-image: true; icon-image: @image-url("../assets/upload.svg"); clicked => { root.import-data(); } }
                        PillButton { horizontal-stretch: 1; text: root.strings.export; use-image: true; icon-image: @image-url("../assets/download.svg"); clicked => { root.export-data(); } }
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: Theme.control-radius;
                        background: #ffffff94;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;
                            Image { width: 15px; height: 15px; source: @image-url("../assets/download.svg"); colorize: Theme.text-muted; image-fit: contain; }
                            Text {
                                horizontal-stretch: 1;
                                text: root.checking-update ? root.strings.checking-update : root.strings.check-update;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                            }
                            if root.has-update: Rectangle { width: 7px; height: 7px; border-radius: 4px; background: Theme.danger; }
                            if root.has-update: Text { text: root.strings.update-available; color: Theme.text-muted; font-size: Theme.font-small; }
                        }
                        TouchArea { enabled: !root.checking-update; mouse-cursor: pointer; clicked => { root.check-update(); } }
                    }

                    Rectangle {
                        height: 20px;
                        Text {
                            text: root.version-label;
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-version(); } }
                    }
                }
            }
        }

        if root.modal-kind == 3: Rectangle {
            background: #1d1d1f3d;
            opacity: root.modal-progress;
            TouchArea { enabled: root.modal-shown; clicked => { root.close-modal(); } }
            Rectangle {
                x: max(12px, (parent.width - self.width) / 2);
                y: (parent.height - self.height) / 2 + (1.0 - root.modal-progress) * 10px;
                width: min(420px, parent.width - 24px);
                height: update-confirm-layout.preferred-height;
                border-radius: Theme.window-radius;
                border-width: 1px;
                border-color: #ffffffa6;
                background: #fffdf4f2;
                drop-shadow-blur: 38px;
                drop-shadow-offset-y: 16px;
                drop-shadow-color: #1f232829;
                TouchArea { }
                update-confirm-layout := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: root.strings.update-available + ": " + root.update-version;
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 650;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.strings.update-confirm-default;
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    if root.update-notes != "": Text {
                        text: root.update-notes;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        PillButton { text: root.strings.cancel; clicked => { root.close-modal(); } }
                        PillButton { text: root.strings.update-confirm; primary: true; clicked => { root.confirm-update(); } }
                    }
                }
            }
        }

        if root.modal-kind == 4: Rectangle {
            background: #1d1d1f3d;
            opacity: root.modal-progress;
            Rectangle {
                x: max(12px, (parent.width - self.width) / 2);
                y: (parent.height - self.height) / 2 + (1.0 - root.modal-progress) * 10px;
                width: min(420px, parent.width - 24px);
                height: update-download-layout.preferred-height;
                border-radius: Theme.window-radius;
                border-width: 1px;
                border-color: #ffffffa6;
                background: #fffdf4f2;
                drop-shadow-blur: 38px;
                drop-shadow-offset-y: 16px;
                drop-shadow-color: #1f232829;
                update-download-layout := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text { text: root.update-status; color: Theme.text; font-size: Theme.font-title; font-weight: 650; }
                    Text { text: "Q Note " + root.update-version; color: Theme.text; font-size: Theme.font-body; font-weight: 600; }
                    if root.update-notes != "": Text { text: root.update-notes; color: Theme.text-muted; font-size: Theme.font-small; wrap: word-wrap; }
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: #3c3c431f;
                        clip: true;
                        Rectangle {
                            width: parent.width * max(0.0, min(1.0, root.update-progress));
                            height: parent.height;
                            border-radius: 4px;
                            background: Theme.accent;
                            animate width { duration: 80ms; easing: linear; }
                        }
                    }
                    HorizontalLayout {
                        Text { horizontal-stretch: 1; text: root.update-progress-label; color: Theme.text-muted; font-size: Theme.font-small; }
                        Text { text: root.update-size-label; color: Theme.text-muted; font-size: Theme.font-small; }
                    }
                    if root.update-can-cancel: HorizontalLayout {
                        alignment: end;
                        PillButton { text: root.strings.cancel; clicked => { root.cancel-update-download(); } }
                    }
                }
            }
        }

        ImagePreview {
            open <=> root.preview-open;
            images: root.preview-images;
            index <=> root.preview-index;
            previous-label: root.strings.previous-image;
            next-label: root.strings.next-image;
            zoom-in-label: root.strings.zoom-in;
            zoom-out-label: root.strings.zoom-out;
            reset-label: root.strings.reset-view;
            close-label: root.strings.cancel;
        }
    }
}
