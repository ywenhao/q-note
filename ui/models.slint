export struct UiAttachment {
    id: string,
    label: string,
    value: string,
    image: image,
    is-image: bool,
}

export struct UiNote {
    id: string,
    content: string,
    display-content: string,
    color: color,
    color-hex: string,
    pinned: bool,
    muted: bool,
    text-height: int,
    min-text-height: int,
    max-text-height: int,
    images: [UiAttachment],
    files: [UiAttachment],
}

export struct UiColor {
    hex: string,
    value: color,
}

