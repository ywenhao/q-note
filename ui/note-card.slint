import { Theme } from "tokens.slint";
import { IconButton } from "components.slint";
import { UiNote, UiStrings } from "models.slint";

export component NoteCard inherits Rectangle {
    in property <UiNote> note;
    in property <UiStrings> strings;
    in property <bool> palette-active: false;
    callback copy-note(string);
    callback edit-note(string);
    callback toggle-pin(string);
    callback open-palette(string, string);
    callback delete-note(string);
    callback preview-image(string, string);
    callback resize-note(string, int);
    callback make-drag-data(string) -> data-transfer;
    callback reorder-note(data-transfer, string, bool);

    property <bool> actions-open: false;
    property <bool> action-trigger-visible: card-area.has-hover
        || trigger-area.has-hover
        || actions-hover.has-hover
        || root.actions-open
        || root.palette-active
        || resize-area.pressed;
    property <float> trigger-progress: root.action-trigger-visible ? 1.0 : 0.0;
    property <float> actions-progress: root.actions-open ? 1.0 : 0.0;
    property <int> resize-start-height: root.note.text-height;
    property <int> draft-text-height: 0;
    property <int> effective-text-height: root.draft-text-height > 0
        ? root.draft-text-height
        : root.note.text-height;
    property <data-transfer> drag-payload;

    animate trigger-progress { duration: 140ms; easing: ease-out; }
    animate actions-progress { duration: 140ms; easing: ease-out; }

    function close-actions() {
        if root.palette-active { return; }
        root.actions-open = false;
    }

    function update-resize(delta: float) {
        root.draft-text-height = round(max(
            root.note.min-text-height,
            min(root.note.max-text-height, root.resize-start-height + delta),
        ));
    }

    function finish-resize() {
        if root.draft-text-height <= 0 { return; }
        let snapped = round(max(
            root.note.min-text-height,
            min(
                root.note.max-text-height,
                ceil(root.draft-text-height / 22.0) * 22.0,
            ),
        ));
        root.resize-note(root.note.id, snapped);
        root.draft-text-height = 0;
    }

    changed palette-active => {
        if root.palette-active {
            close-actions-timer.stop();
            root.actions-open = true;
        } else if !trigger-area.has-hover && !actions-hover.has-hover {
            close-actions-timer.start();
        }
    }

    close-actions-timer := Timer {
        interval: 220ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.palette-active && !trigger-area.has-hover && !actions-hover.has-hover {
                root.actions-open = false;
            }
        }
    }

    width: 100%;
    height: card-layout.preferred-height;
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: root.note.pinned ? #007aff47 : #ffffff80;
    background: root.note.color;
    drop-shadow-blur: card-area.has-hover ? 20px : 14px;
    drop-shadow-offset-y: card-area.has-hover ? 8px : 4px;
    drop-shadow-color: card-area.has-hover ? #1f232824 : #1f23281a;

    card-layout := VerticalLayout {
        padding-left: 10px;
        padding-right: 28px;
        padding-top: 10px;
        padding-bottom: 9px;
        spacing: 8px;

        Text {
            text: root.note.display-content;
            color: root.note.muted ? #1f232873 : Theme.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
            overflow: clip;
            height: root.effective-text-height * 1px;
            vertical-alignment: top;
        }

        if root.note.images.length > 0: HorizontalLayout {
            spacing: 8px;
            height: 58px;
            for attachment in root.note.images: Rectangle {
                width: 58px;
                height: 58px;
                border-radius: 7px;
                border-width: 1px;
                border-color: #1d273524;
                background: #ffffff75;
                clip: true;

                Image {
                    source: attachment.image;
                    image-fit: cover;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.preview-image(root.note.id, attachment.id); }
                }
            }
        }

        if root.note.files.length > 0: VerticalLayout {
            spacing: 6px;
            for attachment in root.note.files: Rectangle {
                height: 30px;
                border-radius: Theme.control-radius;
                border-width: 1px;
                border-color: Theme.border;
                background: #ffffff7a;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;
                    Image { width: 13px; height: 13px; source: @image-url("../assets/file.svg"); colorize: Theme.text-muted; image-fit: contain; }
                    Text {
                        horizontal-stretch: 1;
                        text: attachment.label;
                        color: #1f2328c2;
                        font-size: Theme.font-small;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.note.pinned: Rectangle {
        x: 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffffb8;
        Image {
            x: 2px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: @image-url("../assets/pin-badge.svg");
            colorize: #007affe8;
            image-fit: contain;
        }
    }

    drag-source := DragArea {
        data: root.drag-payload;
        allow-move: true;

        card-area := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-payload = root.make-drag-data(root.note.id);
                }
            }
            clicked => { root.copy-note(root.note.id); }
        }
    }

    DropArea {
        can-drop(event) => { return DragAction.move; }
        dropped(event) => {
            root.reorder-note(event.data, root.note.id, event.position.y > self.height / 2);
            return DragAction.move;
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem { title: root.strings.copy; activated => { root.copy-note(root.note.id); } }
            MenuItem { title: root.strings.edit; activated => { root.edit-note(root.note.id); } }
            MenuItem { title: root.note.pinned ? root.strings.unpin : root.strings.pin; activated => { root.toggle-pin(root.note.id); } }
            MenuSeparator { }
            MenuItem { title: root.strings.delete; activated => { root.delete-note(root.note.id); } }
        }
    }

    action-trigger := Rectangle {
        visible: root.trigger-progress > 0.0;
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        opacity: root.trigger-progress;
        border-radius: 10px;
        background: trigger-area.has-hover || root.actions-open ? #ffffffc7 : #ffffff75;
        Image {
            x: 4px;
            y: 4px;
            width: 12px;
            height: 12px;
            source: @image-url("../assets/chevron-left.svg");
            colorize: trigger-area.has-hover || root.actions-open ? #007affdb : #1d1d1f94;
            image-fit: contain;
        }
        trigger-area := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if self.has-hover {
                    close-actions-timer.stop();
                    root.actions-open = true;
                } else if !root.palette-active && !actions-hover.has-hover {
                    close-actions-timer.start();
                }
            }
            clicked => {
                close-actions-timer.stop();
                root.actions-open = true;
            }
        }
        Tooltip { text: @markdown("\{root.strings.more-actions}"); }
    }

    actions-panel := Rectangle {
        visible: root.actions-progress > 0.0;
        x: parent.width - 22px - self.width + (1.0 - root.actions-progress) * 6px;
        y: (parent.height - self.height) / 2;
        width: actions.preferred-width + 8px;
        height: 30px;
        opacity: root.actions-progress * 0.94;
        border-radius: 12px;
        border-width: 1px;
        border-color: #3c3c4314;
        background: #ffffffdb;
        drop-shadow-blur: 10px;
        drop-shadow-color: #1f23281f;

        actions-hover := TouchArea {
            changed has-hover => {
                if self.has-hover {
                    close-actions-timer.stop();
                    root.actions-open = true;
                } else if !root.palette-active && !trigger-area.has-hover {
                    close-actions-timer.start();
                }
            }
        }

        actions := HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            alignment: center;
            IconButton {
                width: 22px; height: 22px; use-image: true; icon-size: 14px;
                icon-image: root.note.pinned ? @image-url("../assets/pin-off.svg") : @image-url("../assets/pin.svg");
                tooltip: root.note.pinned ? root.strings.unpin : root.strings.pin;
                clicked => {
                    root.toggle-pin(root.note.id);
                    root.close-actions();
                }
            }
            IconButton {
                width: 22px; height: 22px; use-image: true; icon-size: 14px;
                icon-image: @image-url("../assets/edit.svg");
                tooltip: root.strings.edit;
                clicked => {
                    root.edit-note(root.note.id);
                    root.close-actions();
                }
            }
            IconButton {
                width: 22px; height: 22px; use-image: true; icon-size: 14px;
                icon-image: @image-url("../assets/palette.svg");
                tooltip: root.strings.color;
                clicked => {
                    close-actions-timer.stop();
                    root.actions-open = true;
                    root.open-palette(root.note.id, root.note.color-hex);
                }
            }
            IconButton {
                width: 22px; height: 22px; use-image: true; icon-size: 14px;
                icon-image: @image-url("../assets/copy.svg");
                tooltip: root.strings.copy;
                clicked => {
                    root.copy-note(root.note.id);
                    root.close-actions();
                }
            }
            IconButton {
                width: 22px; height: 22px; use-image: true; icon-size: 14px;
                icon-image: @image-url("../assets/trash.svg");
                tooltip: root.strings.delete;
                foreground: Theme.danger;
                hover-foreground: Theme.danger;
                clicked => {
                    root.delete-note(root.note.id);
                    root.close-actions();
                }
            }
        }
    }

    resize-handle := Rectangle {
        x: parent.width - 32px;
        y: parent.height - 13px;
        width: 24px;
        height: 12px;
        border-radius: 8px;
        visible: card-area.has-hover || resize-area.pressed;
        background: resize-area.has-hover ? #ffffff80 : transparent;
        Image {
            x: 6px;
            y: 0px;
            width: 12px;
            height: 12px;
            source: @image-url("../assets/grip-horizontal.svg");
            colorize: resize-area.has-hover ? #1f2937 : #1f293785;
            image-fit: contain;
        }
        resize-area := TouchArea {
            mouse-cursor: ns-resize;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.resize-start-height = root.effective-text-height;
                    root.draft-text-height = root.effective-text-height;
                } else if event.kind == PointerEventKind.up {
                    root.finish-resize();
                } else if event.kind == PointerEventKind.cancel {
                    root.draft-text-height = 0;
                }
            }
            moved => {
                root.update-resize((self.mouse-y - self.pressed-y) / 1px);
            }
        }
        Tooltip { text: @markdown("\{root.strings.resize}"); }
    }
}
