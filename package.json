{
  "name": "q-note",
  "version": "0.2.12",
  "description": "A lightweight desktop note app built with Tauri.",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/ywenhao/q-note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywenhao/q-note.git"
  },
  "bugs": {
    "url": "https://github.com/ywenhao/q-note/issues"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "tauri:dev": "tauri dev",
    "dev": "vp dev",
    "build": "pnpm typecheck && vp build",
    "preview": "vp preview",
    "release": "bumpp package.json src-tauri/tauri.conf.json src-tauri/Cargo.toml --git-check --all --execute \"node scripts/sync-cargo-lock.mjs\" --commit \"release: v%s\" --tag \"v%s\"",
    "release:major": "pnpm run release --release major",
    "release:minor": "pnpm run release --release minor",
    "release:patch": "pnpm run release --release patch",
    "tauri": "tauri",
    "format": "vp format",
    "format:check": "vp format --check",
    "typecheck": "vue-tsc --build --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.ts",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepare": "vp config",
    "test:context-menu": "node --experimental-strip-types --test tests/contextMenuPosition.test.ts",
    "test:update-draft": "node --experimental-strip-types --test tests/updateDraft.test.ts tests/updateRecovery.test.ts",
    "test:updater": "node --experimental-strip-types --test tests/updateProgress.test.ts tests/updateInstallHint.test.ts",
    "test:window-state": "node --experimental-strip-types --test tests/windowState.test.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.28.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "drizzle-orm": "^0.45.2",
    "vue": "3.6.0-rc.7",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "bumpp": "^12.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.0",
    "vite-plus": "^0.3.0",
    "vue-tsc": "^3.3.11"
  }
}
