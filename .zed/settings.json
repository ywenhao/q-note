{
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "tab_size": 2,
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/dist",
    "**/target",
    "**/.tools",
    "**/.nsh"
  ],
  "format_on_save": "on",
  "formatter": "auto",
  "languages": {
    "Rust": {
      "formatter": "language_server",
      "tab_size": 4
    },
    "TSX": {
      "prettier": {
        "allowed": true
      }
    },
    "TypeScript": {
      "prettier": {
        "allowed": true
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  }
}
